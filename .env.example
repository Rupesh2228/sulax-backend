NODE_ENV=development
PORT=5000

# MongoDB connection string (local or Atlas)
MONGO_URI=mongodb://127.0.0.1:27017/sulax

# REQUIRED: long random string (32+ chars). Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Exact origin(s) of the React app, comma-separated (used for CORS)
CLIENT_ORIGIN=http://localhost:5173

# Optional browser push (Web Push API). Generate VAPID keys with:
#   npm exec web-push generate-vapid-keys
# Keep the private key only in the backend environment. Subject must be mailto: or HTTPS.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Used only by `npm run seed` to create the first admin. No default credentials are shipped.
ADMIN_EMAIL=
ADMIN_PASSWORD=
